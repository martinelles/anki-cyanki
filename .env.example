# ==========================================
# Cyanki - Variáveis de ambiente (modelo)
# Copie para .env e preencha. O .env é ignorado pelo git.
# ==========================================

# --- Banco de dados (PostgreSQL) ---
DB_USER=cyanki
DB_PASSWORD=
DB_NAME=cyanki
DB_NAME_PROD=cyanki_prod

# --- Backend (FastAPI) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5174

# --- E-mail (opcional - deixe em branco em dev) ---
SERVER_MAIL_SERVER=
SERVER_MAIL_PORT=465
SERVER_MAIL_USER=
SERVER_MAIL_PASSWORD=
SERVER_MAIL_SENDER=
SERVER_HTTPS=false

# --- Túnel Cloudflare (só em produção) ---
# Token do painel Zero Trust; usado por docker-compose.prod.yml
CLOUDFLARE_TUNNEL_TOKEN=
