# URL base da API, usada via $env/static/public no código do frontend.
# Resolvida pelo navegador do host: use localhost, não o nome do serviço no compose.
# No docker-compose.yml de desenvolvimento este valor já vem pelo `environment`,
# então este arquivo só é necessário para rodar o Vite fora do Docker (npm run dev).
PUBLIC_API_URL=http://localhost:8000/api

# Em produção o arquivo lido pelo `vite build` é .env.production (ignorado pelo
# git, como todo .env.*), e o valor precisa ser relativo: o nginx do
# docker-compose.prod.yml serve o app e faz proxy de /api/ para o backend na
# mesma origem.
#   PUBLIC_API_URL=/api
